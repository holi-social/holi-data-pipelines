#!/usr/bin/env bash

export PYTHONPATH=.:$PYTHONPATH

if [ ! -f ".envrc.local" ]; then
  cp .envrc.local.template .envrc.local
  echo_yellow ".envrc.local was created from template, please add your configuration if necessary"
fi

# loads personal (secret) data from separate env file (not checked in)
source_env_if_exists .envrc.local

pre-commit install 1> /dev/null
