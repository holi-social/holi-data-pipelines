#!/usr/bin/env bash

export DIRENV_WARN_TIMEOUT=60s
set -e -o pipefail

echo_green() {
  echo -e "\033[32m$1\033[0m"
}

echo_red() {
  echo -e "\033[31m$1\033[0m"
}

echo_yellow() {
  echo -e "\033[33m$1\033[0m"
}

EXPECTED_PYTHON_VERSION=$(cat .python-version)
ACTUAL_PYTHON_VERSION=$(python3 --version | cut -c 8-)

if [[ "$EXPECTED_PYTHON_VERSION" != "$ACTUAL_PYTHON_VERSION" ]]
then
  echo_red "The installed python version ($ACTUAL_PYTHON_VERSION) differs from the expected version ($EXPECTED_PYTHON_VERSION)" >&2
  echo_red "Please see README.md to learn how to set up your local dev environment correctly" >&2
  exit 1
fi

hash_files_by_pattern() {
  local dir="$1"
  local pattern="$2"
  if [ -z "$pattern" ]; then
    echo_red "Usage: hash_files_by_pattern <file_pattern>" >&2
    return 1
  fi
  # Find files matching the pattern, calculate sha256sum for each,
  # sort the results, and then calculate a final sha256sum
  find $dir -maxdepth 1 -name "$pattern" -type f -exec sha256sum {} \; | sort | sha256sum | cut -d ' ' -f 1
}

ensure_venv_exists() {
  local venv_dir="$1"

  if [ ! -d "$venv_dir" ]
  then
    echo_green "No Python venv in $venv_dir found, creating..."
    python3 -m venv $venv_dir
  fi
}

pip_install_required() {
  local hash_file_path="$1"
  local current_sha256="$2"
  [ ! -f "$hash_file_path" ] || [ ! "$(cat "$hash_file_path")" = "$current_sha256" ]
}

ensure_deps_up_to_date() {
  local dir="$1"
  local venv_dir="$dir/.venv/"
  local sha_file="$venv_dir/reqs_sha256.txt"

  current_sha256=$(hash_files_by_pattern $dir "*requirements.txt")

  if [ ! -f "$sha_file" ] || [ ! "$(cat $sha_file)" = $current_sha256 ]
  then
    echo_green "Installing / updating dependencies in venv \"$venv_dir\"..."

    source $venv_dir/bin/activate
    pip install --upgrade pip | grep -v 'already satisfied' || true
    pip install -r "$dir/requirements.txt" | grep -v 'already satisfied' || true
    pip install -r "$dir/dev-requirements.txt" | grep -v 'already satisfied' || true
    touch "$sha_file"
    echo "$current_sha256" > "$sha_file"
  fi
}

#ensure_venv_exists .venv
#ensure_venv_exists pubsub_typesense_updater/.venv

#ensure_deps_up_to_date .
#ensure_deps_up_to_date pubsub_typesense_updater

#source .venv/bin/activate

#export VIRTUAL_ENV=.venv
#layout python
#export PYTHONPATH=$PYTHONPATH:.

if [ ! -f ".envrc.local" ]; then
  cp .envrc.local.template .envrc.local
  echo_yellow ".envrc.local was created from template, please add your configuration if necessary"
fi

# loads personal (secret) data from separate env file (not checked in)
source_env_if_exists .envrc.local

pre-commit install 1> /dev/null

#uv sync
