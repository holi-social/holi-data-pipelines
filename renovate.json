{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    ":label('renovatebot')",
    ":enableVulnerabilityAlertsWithLabel('renovatebot/security')",
    ":semanticCommits",
    ":automergePatch",
    ":automergeTesters",
    ":automergeLinters"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchJsonata": [
        "$match(depName,/prefect-gcp$/)",
        "$match(depName,/prefect$/)"
      ],
      "group": {"branchTopic": "{{{groupSlug}}}", "commitMessageTopic": "{{{groupName}}} ⚠️NEEDS REDEPLOY OF PREFECT SERVER!"},
      "groupName": "prefect",
      "automerge": false
    },
    {
      "matchSourceUrls": [
        "https://github.com/hashicorp/terraform"
      ],
      "groupName": "terraform"
    },
    {
      "matchJsonata": [
        "$match(depName,/python$/)"
      ],
      "groupName": "python"
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    }
  ]
}