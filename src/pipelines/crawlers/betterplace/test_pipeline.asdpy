import unittest
from unittest.mock import AsyncMock, patch, MagicMock
from datetime import date

from src.pipelines.crawlers.betterplace.pipeline import crawl_betterplace, crawl
from src.pipelines.crawlers.crawler_config import CrawlerConfig


old_partition_date = date(2025, 8, 19)
new_partition_date = date(2025, 8, 20)

test_config = CrawlerConfig(
    partition_date=new_partition_date,
    state_variable_name="betterplace_crawler_state",
    api_url="betterplace_api_url",
    bigquery_table={
        "project": "project_id",
        "dataset": "datalake",
        "table": "donations_betterplace_raw",
    },
)


class TestBetterplacePipelineFlow(unittest.TestCase):
    @patch("src.pipelines.crawlers.betterplace.pipeline.RestCrawler", return_value=AsyncMock())
    @patch("src.pipelines.crawlers.betterplace.pipeline.delete_partition")
    @patch("src.pipelines.crawlers.betterplace.pipeline.wait_for_bigquery_data_to_be_accessible")
    @patch("src.pipelines.crawlers.betterplace.pipeline.report_number_of_processed_entities")
    @patch("src.pipelines.crawlers.betterplace.pipeline.is_streaming_buffer_empty")
    @patch("src.pipelines.crawlers.crawler_common_code.stream_to_bigquery")
    @patch("src.pipelines.crawlers.betterplace.pipeline.update_last_successful_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.update_last_run_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.is_cleanup_needed", return_value=False)
    @patch("src.pipelines.crawlers.betterplace.pipeline.has_run_successfully_for_day", return_value=False)
    @patch("src.pipelines.crawlers.betterplace.pipeline.get_last_successful_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.crawl", new_callable=crawl.fn)
    @patch("src.pipelines.crawlers.betterplace.pipeline.config", return_value=test_config)
    def test_should_run_crawler_and_return_dates(
        self,
        mock_config,
        crawl_mock,
        get_last_successful_day_mock,
        has_run_successfully_for_day_mock,
        is_cleanup_needed_mock,
        update_last_run_day_mock,
        update_last_successful_day_mock,
        stream_to_bigquery_mock,
        is_streaming_buffer_empty_mock,
        report_number_of_processed_entities_mock,
        wait_for_bigquery_data_to_be_accessible_mock,
        delete_partition_mock,
        rest_crawler_mock,
    ):
        # rest_crawler_mock.crawl = AsyncMock()
        dates = crawl_betterplace.fn(dry_run=True)  # TODO(SF) dry run for now
        self.assertEqaul(dates, (old_partition_date, new_partition_date))

    # def test_should_update_prefect_state_and_dates_on_successful_run(self):
    #     self.assertTrue(False)

    # def test_should_not_wait_for_bq_if_not_requested(self):
    # crawl_betterplace.fn(wait_for_bq=False)
    #     self.assertTrue(False)

    # def test_should_simulate_run_if_requested(self):
    # crawl_betterplace.fn(dry_run=True)
    #     self.assertTrue(False)

    # def test_should_clean_up_unfinished_run(self):
    #     self.assertTrue(False)

    # def test_should_abort_run_if_streaming_buffer_is_not_empty(self):
    #     self.assertTrue(False)

    @patch("src.pipelines.crawlers.betterplace.pipeline.RestCrawler")
    @patch("src.pipelines.crawlers.betterplace.pipeline.delete_partition")
    @patch("src.pipelines.crawlers.betterplace.pipeline.wait_for_bigquery_data_to_be_accessible")
    @patch("src.pipelines.crawlers.betterplace.pipeline.report_number_of_processed_entities")
    @patch("src.pipelines.crawlers.betterplace.pipeline.is_streaming_buffer_empty")
    @patch("src.pipelines.crawlers.crawler_common_code.stream_to_bigquery")
    @patch("src.pipelines.crawlers.betterplace.pipeline.update_last_successful_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.update_last_run_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.is_cleanup_needed")
    @patch("src.pipelines.crawlers.betterplace.pipeline.has_run_successfully_for_day", return_value=True)
    @patch("src.pipelines.crawlers.betterplace.pipeline.get_last_successful_day")
    @patch("src.pipelines.crawlers.betterplace.pipeline.crawl", new_callable=crawl.fn)
    @patch("src.pipelines.crawlers.betterplace.pipeline.config", return_value=test_config)
    def test_should_skip_run_if_already_run_successfully(
        self,
        mock_config,
        crawl_mock,
        get_last_successful_day_mock,
        has_run_successfully_for_day_mock,
        is_cleanup_needed_mock,
        update_last_run_day_mock,
        update_last_successful_day_mock,
        stream_to_bigquery_mock,
        is_streaming_buffer_empty_mock,
        report_number_of_processed_entities_mock,
        wait_for_bigquery_data_to_be_accessible_mock,
        delete_partition_mock,
        rest_crawler_mock,
    ):
        with self.assertRaises(Exception) as ctx:
            crawl_betterplace.fn(dry_run=True)  # TODO(SF) dry run for now
        self.assertEqual("Crawling already ran successfully for today, skipping run.", str(ctx.exception))

