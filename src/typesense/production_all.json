{
    "name": "holi_search_production",
    "enable_nested_fields": true,
    "fields": [
        {"name": "id", "type": "string"},
        {"name": "type", "type": "string", "facet": true},
        {
            "name": "title_de",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "locale": "de"
        },
        {
            "name": "title_en",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "locale": "en"
        },
        {
            "name": "description_de",
            "type": "string",
            "optional": true,
            "comment": "current assumption: we don't have really long text, so we don't store as separate paragraphs",
            "stem": true,
            "locale": "de"
        },
        {
            "name": "description_en",
            "type": "string",
            "optional": true,
            "comment": "current assumption: we don't have really long text, so we don't store as separate paragraphs",
            "stem": true,
            "locale": "en"
        },
        {"name": "location", "type": "string", "optional": true},
        {"name": "location_type", "type": "string", "optional": true, "facet": true},
        {"name": "location_lat_lng", "type": "geopoint", "optional": true},
        {"name": "image_url", "type": "string", "optional": true, "index": false},
        {
            "name": "link_locators",
            "type": "object",
            "comment": "Stores locators for volunteering. Example: {'volunteering': '1234'}",
            "index": false
        },
        {
            "name": "user_full_name",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "sort": true,
            "comment": "enabling sort can help display results in some meaningful order, such as alphabetical"
        },
        {
            "name": "embedding",
            "type": "float[]",
            "optional": true,
            "embed": {
                "from": [
                    "title_de",
                    "title_en",
                    "description_de",
                    "description_en",
                    "location"
                ],
                "model_config": {
                    "model_name": "ts/multilingual-e5-base"
                }
            }
        },
        {
            "name": "topics_v2",
            "type": "string[]",
            "optional": true,
            "index": true
        },
        {
            "name": "skills_v2",
            "type": "string[]",
            "optional": true,
            "index": true
        },
        {
            "name": "topics_skills_embedding_v2",
            "type": "float[]",
            "optional": true,
            "num_dim": 53
        },
        {
            "name": "similarity_embedding",
            "type": "float[]",
            "optional": true,
            "num_dim": 256
        },
        {"name": "organizer_name", "type": "string", "optional": true, "index":  false},
        {"name": "organizer_image_url", "type": "string", "optional": true, "index":  false},
        {"name": "external_url", "type": "string", "optional": true, "index":  false},
        {"name": "source", "type": "string", "optional": true, "index":  false},
        {"name": "commitment_label", "type": "string", "optional": true, "facet": true},
        {
            "name": "time_required",
            "type": "string",
            "optional": true,
            "facet": true
        },
        {
            "name": "time_required_ai_derived",
            "type": "boolean",
            "optional": true,
            "facet": false,
            "index": false
        },
        {
            "name": "time_required_ai_reasoning",
            "type": "string",
            "optional": true,
            "facet": false,
            "index": false
        },
        {"name": "space_id", "type": "string", "optional": true},
        {"name": "commitment_duration", "type": "string", "optional": true}
    ]
}