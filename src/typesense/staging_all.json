{
    "name": "holi_search_staging",
    "enable_nested_fields": true,
    "fields": [
        {"name": "id", "type": "string"},
        {"name": "type", "type": "string", "facet": true},
        {
            "name": "title_de",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "locale": "de"
        },
        {
            "name": "title_en",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "locale": "en"
        },
        {
            "name": "description_de",
            "type": "string",
            "optional": true,
            "comment": "current assumption: we don't have really long text, so we don't store as separate paragraphs",
            "stem": true,
            "locale": "de"
        },
        {
            "name": "description_en",
            "type": "string",
            "optional": true,
            "comment": "current assumption: we don't have really long text, so we don't store as separate paragraphs",
            "stem": true,
            "locale": "en"
        },
        {"name": "location", "type": "string", "optional": true},
        {"name": "location_lat_lng", "type": "geopoint", "optional": true},
        {"name": "image_url", "type": "string", "optional": true, "index": false},
        {
            "name": "link_locators",
            "type": "object",
            "comment": "Stores locators for volunteering. Example: {'volunteering': '1234'}",
            "index": false
        },
        {
            "name": "full_name",
            "type": "string",
            "optional": true,
            "infix": true,
            "stem": true,
            "sort": true,
            "comment": "enabling sort can help display results in some meaningful order, such as alphabetical"
        },
        {
            "name": "embedding",
            "type": "float[]",
            "optional": true,
            "embed": {
                "from": [
                    "title_de",
                    "title_en",
                    "description_de",
                    "description_en",
                    "location"
                ],
                "model_config": {
                    "model_name": "ts/distiluse-base-multilingual-cased-v2"
                }
            }
        }
    ]
}
