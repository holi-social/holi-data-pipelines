#!/bin/bash
#!/bin/bash

# don't execute the startup script on reboots
if [[ -f /etc/startup_script_was_run_successfully ]]; then exit 0; fi

# log script output to file for later inspection
set -o errexit
readonly LOG_FILE="/var/log/startup-script.log"
touch $LOG_FILE
# Open standard out at `$LOG_FILE` for write.
# This has the effect of stdout ending up in the logfile
exec 1>$LOG_FILE
# Redirect standard error to standard out such that
# standard error ends up going to wherever standard
# out goes (the file).
exec 2>&1

# unattended upgrades, python3-gi for using shutdown signal instead of polling
apt install -y unattended-upgrades python3-gi
echo unattended-upgrades unattended-upgrades/enable_auto_updates boolean true | debconf-set-selections
dpkg-reconfigure -f noninteractive unattended-upgrades
cat << 'EOF' > /etc/apt/apt.conf.d/99unattended-upgrades
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=$${distro_codename}";
        "origin=google-compute-engine-$${distro_codename}-stable";
        "origin=cloud-sdk-$${distro_codename}";
        "origin=google-cloud-ops-agent-$${distro_codename}";
        "origin=Docker";
};
Unattended-Upgrade::Automatic-Reboot "true";
EOF

# log retention for systemd-journald
cat << 'EOF' > /etc/systemd/journald.conf
[Journal]
MaxRetentionSec=1month
EOF
systemctl restart systemd-journald

# Ops Agent for logging to StackDriver
# install the agent
curl -sSO https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh
bash add-google-cloud-ops-agent-repo.sh --also-install
# custom logging and monitoring config
cat << 'EOF' > /etc/google-cloud-ops-agent/config.yaml
logging:
  receivers:
    unattended-upgrades:
      type: files
      include_paths: [/var/log/unattended-upgrades/*.log]
      record_log_file_path: true
    startup:
      type: files
      include_paths: [/var/log/startup-script.log]
      record_log_file_path: true
    systemd-journald:
      type: systemd_journald
  service:
    pipelines:
      custom:
        receivers:
          - unattended-upgrades
          - startup
          - systemd-journald
metrics:
  receivers:
    hostmetrics:
      type: hostmetrics
      # Inspired by https://blog.emn178.cc/en/post/gcp-cloud-monitoring-reduce-data-and-cost/
      collection_interval: 60s
  processors:
    metrics_filter:
      type: exclude_metrics
      metrics_pattern:
        # Inspired by https://blog.emn178.cc/en/post/gcp-cloud-monitoring-reduce-data-and-cost/
        # The following are the metrics to be excluded. Comment out the required metrics.
        - agent.googleapis.com/agent/*
        #- agent.googleapis.com/cpu/*
        # keep only percentage_used and io_time for disk
        #- agent.googleapis.com/disk/percentage_used
        #- agent.googleapis.com/disk/io_time
        - agent.googleapis.com/disk/read_bytes_count
        - agent.googleapis.com/disk/write_bytes_count
        - agent.googleapis.com/disk/bytes_used
        - agent.googleapis.com/disk/weighted_io_time
        - agent.googleapis.com/disk/merged_operations
        - agent.googleapis.com/disk/operation_time
        - agent.googleapis.com/disk/operation_count
        - agent.googleapis.com/disk/pending_operations
        #- agent.googleapis.com/interface/*
        #- agent.googleapis.com/memory/*
        #- agent.googleapis.com/network/*
        - agent.googleapis.com/processes/*
        #- agent.googleapis.com/swap/*
  service:
    pipelines:
      default_pipeline:
        receivers:
          - hostmetrics
        processors:
          - metrics_filter
global:
  default_self_log_file_rotation:
    enabled: true
    max_file_size_megabytes: 1
    backup_count: 1
EOF
# install logrotation
apt install -y logrotate

# docker apt sources TODO docker most probably is not needed on the server
apt install -y ca-certificates curl gnupg lsb-release

# nginx
apt install -y nginx
# set up stub_status for nginx monitoring via Ops Agent
cat << 'EOF' > /etc/nginx/conf.d/status.conf
server {
  listen 80;
  server_name 127.0.0.1;
  location /nginx_status {
    stub_status on;
    access_log off;
    allow 127.0.0.1;
    deny all;
  }
  location / {
   root /dev/null;
  }
}
EOF
# make sure that nginx logs which contain PII (IP addresses) get deleted after 2 days
cat << 'EOF' > /etc/logrotate.d/nginx
/var/log/nginx/*.log {
  daily
  missingok
  rotate 2
  compress
  delaycompress
  notifempty
  create 0640 www-data adm
  sharedscripts
  prerotate
    if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
      run-parts /etc/logrotate.d/httpd-prerotate; \
    fi \
  endscript
  postrotate
    invoke-rc.d nginx rotate >/dev/null 2>&1
  endscript
}
EOF
systemctl restart logrotate

# nginx site
cat << EOF > /etc/nginx/sites-available/prefect-server
map \$http_upgrade \$connection_upgrade {
  default upgrade;
  ''      close;
}
server {
  listen ${internal_port};
  server_name localhost ${internal_domain};

  access_log /var/log/nginx/prefect-server-internal.access.log;
  error_log /var/log/nginx/prefect-server-internal.error.log;

  location / {
    allow ${allowed_cidr_range};
    allow 127.0.0.1;
    deny  all;

    resolver 1.1.1.1 ipv6=off valid=30s;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header Host \$http_host;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection \$connection_upgrade;
    proxy_pass http://localhost:4200;
    proxy_redirect off;
  }
}
EOF
ln -fs /etc/nginx/sites-available/prefect-server /etc/nginx/sites-enabled/prefect-server
rm -f /etc/nginx/sites-enabled/default
systemctl reload nginx

# prefect setup
apt install -y python3-venv
mkdir -p /srv/prefect-server
python3 -m venv /srv/prefect-server/.venv
source /srv/prefect-server/.venv/bin/activate
pip3 install -U pip
cat >requirements.txt <<EOL
${requirements}
EOL
pip3 install -r requirements.txt

cat << EOF > /srv/prefect-server/profiles.toml
active = "default"

[profiles.default]
PREFECT_SERVER_ALLOW_EPHEMERAL_MODE = "True"
PREFECT_SERVER_API_CSRF_PROTECTION_ENABLED = "False"
PREFECT_API_TLS_INSECURE_SKIP_VERIFY = "False"
PREFECT_SERVER_LOGGING_LEVEL = "WARNING"
PREFECT_SERVER_ANALYTICS_ENABLED = "False"
PREFECT_SERVER_METRICS_ENABLED = "True"
PREFECT_SERVER_REGISTER_BLOCKS_ON_START = "True"
PREFECT_API_ENABLE_METRICS = "True"
PREFECT_API_URL = "http://${internal_domain}:${internal_port}/api"
PREFECT_UI_API_URL = "http://${internal_domain}:${internal_port}/api"
PREFECT_UI_URL = "http://${internal_domain}:${internal_port}/"
PREFECT_API_DATABASE_CONNECTION_URL="postgresql+asyncpg://${database_username}:${database_password}@${database_host}:5432/${database_name}"
PREFECT_SERVER_DATABASE_SQLALCHEMY_POOL_PRE_PING = "True"
PREFECT_SERVER_DATABASE_SQLALCHEMY_POOL_SIZE = "5"
PREFECT_SERVER_DATABASE_SQLALCHEMY_MAX_OVERFLOW = "10"
PREFECT_SERVER_DATABASE_CONNECTION_TIMEOUT = "10"
EOF

cat << 'EOF' > /etc/systemd/system/prefect-server.service
[Unit]
Description=Prefect Server
AssertFileNotEmpty=/srv/prefect-server/profiles.toml
AssertPathIsDirectory=/srv/prefect-server/.venv

[Service]
Environment=VIRTUAL_ENV="/srv/prefect-server/.venv"
Environment=PREFECT_HOME="/srv/prefect-server"
Environment=PREFECT_PROFILES_PATH="/srv/prefect-server/profiles.toml"
Restart=on-failure
RestartSec=5
WorkingDirectory=/srv/prefect-server
ExecStart=/srv/prefect-server/.venv/bin/prefect server start
ExecStop=/srv/prefect-server/.venv/bin/prefect server stop

[Install]
WantedBy=multi-user.target
EOF

cat << 'HEALTHCHECK_EOF' > /srv/prefect-server/healthcheck.sh
#!/bin/bash
if ! curl -sf --max-time 10 http://localhost:4200/api/health > /dev/null 2>&1; then
  echo "$(date -Iseconds) Prefect health check failed, restarting service" | systemd-cat -t prefect-healthcheck -p warning
  systemctl restart prefect-server
fi
HEALTHCHECK_EOF
chmod +x /srv/prefect-server/healthcheck.sh

cat << 'EOF' > /etc/systemd/system/prefect-healthcheck.service
[Unit]
Description=Prefect Server Health Check
After=prefect-server.service

[Service]
Type=oneshot
ExecStart=/srv/prefect-server/healthcheck.sh
EOF

cat << 'EOF' > /etc/systemd/system/prefect-healthcheck.timer
[Unit]
Description=Run Prefect health check every 60 seconds

[Timer]
OnBootSec=120
OnUnitActiveSec=60

[Install]
WantedBy=timers.target
EOF

systemctl enable --now prefect-server
systemctl enable --now prefect-healthcheck.timer

prefect version

sleep 10 # wait for the server to start
PREFECT_API_URL=http://${internal_domain}:${internal_port}/api prefect block register -m prefect_gcp

touch /etc/startup_script_was_run_successfully

# signal we're done to the log file
echo "done"